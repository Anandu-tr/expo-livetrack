<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Permissions the config plugin does NOT add but this layer needs. They merge
    into the host app manifest at build time.
      - REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: ensureNotKilled() fires
        ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS. Google Play restricts this
        permission to apps with a qualifying background use case (continuous
        location tracking qualifies); the host app's listing must justify it.
      - SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM: Watchdog uses
        setExactAndAllowWhileIdle on Android 12+ (gated by canScheduleExactAlarms;
        falls back to inexact otherwise).
    VERIFY: confirm these are acceptable for the host app's Play listing.
  -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <!-- Internet on/off events (NET_OFF / NET_ON heartbeats). Normal permission, no prompt. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Keeps the CPU awake for a 3 s accelerometer motion check. Normal permission, no prompt. -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <!--
      Activity Recognition results (ActivityRegistrations). Declared here rather
      than by the config plugin: library manifests merge into the host app.
      Not exported - the PendingIntent is sent with this app's own identity.
    -->
    <receiver
      android:name="expo.modules.livetrack.ActivityReceiver"
      android:exported="false" />
  </application>
</manifest>
